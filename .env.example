# ============================================================================
# Kinship — Environment Variables
# ============================================================================
# Copy to `.env.local` and fill in real values.
#
# SECURITY NOTE:
# There is deliberately NO `NEXT_PUBLIC_SUPABASE_ANON_KEY` here. The browser
# never talks to Supabase directly — every database read/write goes through an
# authenticated Next.js API route that holds the service role key on the
# server. The `anon` and `authenticated` roles are revoked in
# `supabase/migrations/004_rls_policies.sql`.
#
# `SUPABASE_SERVICE_ROLE_KEY` bypasses row level security. Never expose it to
# the client, never commit it, never log it. `lib/supabase/server.ts` imports
# `server-only` so the bundler throws if it is ever pulled into a client bundle.
# ============================================================================

# ---------------------------------------------------------------------------
# Clerk (authentication)
# ---------------------------------------------------------------------------
# Dashboard → https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# App URLs — used by Clerk for redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends a user right after authentication.
# IMPORTANT: the dashboard route group is `(dashboard)/home`, so the landing
# path is `/home` — NOT `/dashboard`, which 404s.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/home

# ---------------------------------------------------------------------------
# Supabase (database)
# ---------------------------------------------------------------------------
# Project URL → Project Settings → API
# Name is kept as-is for compatibility with the existing Vercel configuration,
# even though it is now only read on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key → Project Settings → API → service_role
# Server-only. Bypasses RLS — treat it like a root database password.
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role_key

# ---------------------------------------------------------------------------
# Demo mode (optional)
# ---------------------------------------------------------------------------
# Demo mode serves the fixtures in `data/` instead of the database so a
# pastor can see the product without a live database. It is OFF unless this
# is exactly "true".
#
# When it is on:
#   - every board shows a "Demo data" banner, so nobody can mistake the
#     sample content for their church's real information;
#   - all write endpoints return 403 - a demo never touches a real database.
#
# It is read on the server only, on purpose. Do NOT rename it to a
# NEXT_PUBLIC_* variable: a public flag is baked into the client bundle at
# build time and can drift from what the server is actually serving.
KINSHIP_DEMO_MODE=false
